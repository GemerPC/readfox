{
  "name": "readfox",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-07-18",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/generate",
      "/translate",
      "/translate-word",
      "/translate-word-simple",
      "/prepare-text",
      "/pronunciation",
      "/dialogue",
      "/speech",
      "/academy"
    ]
  },
  "build": {
    "command": "node build-cloudflare.mjs"
  },
  "keep_vars": true
}

